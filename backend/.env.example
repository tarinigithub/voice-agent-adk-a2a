# OpenAI Realtime (voice agent) - https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Google ADK research agent (Gemini) - https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq voice agent (alternative to OpenAI Realtime) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Capstone school agent (A2A) - see ../adk-a2a-mcp-education-capstone
SCHOOL_A2A_URL=http://localhost:8002

# Agent Registry - agents are discovered by name here (SCHOOL_A2A_URL is the fallback)
AGENT_REGISTRY_URL=http://localhost:8003
